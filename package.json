{
  "name": "wecert",
  "version": "1.0.0",
  "description": "WeCert vocational training and career support demo for Hong Kong learners.",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test tests/domain.test.cjs tests/server-domain.test.cjs",
    "test:browser": "playwright test",
    "build": "node scripts/build-public.cjs && node scripts/migrate.mjs",
    "dev": "node --env-file=.env.local scripts/dev-server.mjs",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "test:classroom": "node --env-file=.env.local tests/classroom.e2e.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashleyyeeman/wecert.git"
  },
  "keywords": [],
  "author": "",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ashleyyeeman/wecert/issues"
  },
  "homepage": "https://github.com/ashleyyeeman/wecert#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "private": true,
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.22",
    "dotenv": "^18.0.10",
    "hono": "^4.13.18",
    "https-proxy-agent": "^9.1.0",
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  }
}
